plugins {
    id 'nf-amazon'
    id 'nf-ga4gh'
}

docker {
    enabled = true
}

process {
    executor = 'tes'
}

tes {
    endpoint = System.getenv('FUNNEL_ADDRESS') ?: 'http://funnel:8000'
    timeout = 30
    pollInterval = '10s'
}

aws {
    region = 'us-east-1'
    accessKey = System.getenv('S3_USER') ?: 'versitygw'
    secretKey = System.getenv('S3_PASSWORD') ?: 'versitygw'
    client {
        endpoint = System.getenv('S3_ENDPOINT') ?: 'http://s3:7070'
        s3PathStyleAccess = true
    }
}