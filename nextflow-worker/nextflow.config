plugins {
    id 'nf-amazon'
    id 'nf-ga4gh'
}

docker {
    enabled = true
}

process {
    executor = 'tes'

    publishDir = [
        path: params.destinationPath,
        mode: 'copy'
    ]
}

tes {
    endpoint = System.getenv('FUNNEL_ADDRESS') ?: 'http://tigerdb-funnel:8000'
    timeout = 30
    pollInterval = '10s'
}

aws {
    region = 'us-east-1'
    accessKey = System.getenv('MINIO_USER') ?: 'minioadmin'
    secretKey = System.getenv('MINIO_PASSWORD') ?: 'minioadmin'
    client {
        endpoint = System.getenv('MINIO_ENDPOINT') ?: 'http://tigerdb-minio:9000'
        s3PathStyleAccess = true
    }
}